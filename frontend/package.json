{
  "name": "smart-instrument-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "axios": "^1.7.9",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "pinia": "^2.3.0",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.2.1",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "vite": "^6.0.3",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.smartinstrument.app",
    "productName": "SmartInstrument",
    "copyright": "Copyright © 2026 ${author}",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
